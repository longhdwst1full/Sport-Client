# Địa chỉ backend — CHỈ server đọc (không có tiền tố NEXT_PUBLIC_ nên không lọt vào JS trình duyệt).
# Trình duyệt gọi /api/v1/* của chính storefront; route app/api/v1/[...path] proxy sang đây.
API_URL=https://sport-api-doc.vercel.app
# STOREFRONT_PROXY_SECRET: KHÔNG ghi vào file commit — đặt trên Vercel (Environment Variables), trùng
# giá trị với backend, ≥ 32 ký tự.
NEXT_PUBLIC_AUTH_TOKEN_TRANSPORT=COOKIE
# Public build-time config; có thể override bằng Vercel Environment Variable.
NEXT_PUBLIC_GUEST_ORDER_TOKEN_TTL_DAYS=90
NEXT_PUBLIC_SITE_URL=https://www.baoansprot.click
