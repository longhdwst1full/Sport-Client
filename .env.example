NEXT_PUBLIC_API_URL=https://sport-api-doc.vercel.app
NEXT_PUBLIC_AUTH_TOKEN_TRANSPORT=COOKIE
# Public build-time config; có thể override bằng Vercel Environment Variable.
NEXT_PUBLIC_GUEST_ORDER_TOKEN_TTL_DAYS=90
NEXT_PUBLIC_SITE_URL=https://baoansport.vn

# Server-only. Secret cho webhook `POST /api/revalidate` (API gọi khi đăng/sửa bài viết, sản phẩm,
# danh mục để trang ISR hiện nội dung mới ngay). Bỏ trống = endpoint tắt (503).
REVALIDATE_SECRET=
# Build-time. `true` để tắt bộ tối ưu ảnh của Next nếu hạn mức Image Optimization không đủ.
NEXT_IMAGE_UNOPTIMIZED=
